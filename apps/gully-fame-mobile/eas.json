{
  "build": {
    "preview": {
      "android": {
        "buildType": "apk",
        "env": {
          "EXPO_PUBLIC_ENV": "preview",
          "SENTRY_DISABLE_AUTO_UPLOAD": "true"
        }
      },
      "ios": {
        "simulator": true,
        "env": {
          "EXPO_PUBLIC_ENV": "preview"
        }
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle",
        "env": {
          "EXPO_PUBLIC_ENV": "production"
        }
      },
      "ios": {
        "env": {
          "EXPO_PUBLIC_ENV": "production"
        }
      }
    }
  }
}